rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal data tree — owner only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Invite-code lookup: any signed-in user may resolve a code to a group id
    // (needed to join). Codes carry no sensitive data.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Teams.
    match /groups/{groupId} {
      // Only members can read the group.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // Creator must include themselves as owner + first member.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      // Join: add ONLY yourself to memberUids, change nothing else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid]))
        && request.auth.uid in request.resource.data.memberUids;

      // Leaving: remove ONLY yourself.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && resource.data.memberUids.hasOnly(request.resource.data.memberUids.concat([request.auth.uid]));

      // Owner may edit/delete the group.
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Per-member progress cards.
      match /members/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow write: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
      }
    }
  }
}
